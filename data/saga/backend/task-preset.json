{
  "$schema": "https://tasks.hagicode.com/schemas/task-preset-plugin/task-preset.schema.json",
  "taskKey": "saga",
  "scriptKey": "hagitask.saga",
  "defaultTargetType": "repository",
  "requirements": [
    {
      "type": "agent",
      "name": "any"
    },
    {
      "type": "cli",
      "name": "node",
      "command": "node",
      "args": [
        "--version"
      ]
    }
  ],
  "targets": {
    "repositories": {
      "enabled": true,
      "selections": [
        {
          "id": "targetRepositories",
          "selectionMode": "multiple",
          "allowedAccessTypes": [
            "read",
            "write"
          ],
          "output": "targetRepositories",
          "required": false,
          "scope": {
            "source": "owner-project-repositories"
          }
        }
      ]
    },
    "vaults": {
      "enabled": false
    },
    "projects": {
      "enabled": false
    }
  },
  "inputBindings": [
    {
      "input": "command",
      "promptParameter": "command",
      "metadataKey": "autoTaskSagaCommand",
      "required": true
    },
    {
      "input": "sagaId",
      "promptParameter": "sagaId",
      "metadataKey": "autoTaskSagaSagaId",
      "required": false
    },
    {
      "input": "objective",
      "promptParameter": "objective",
      "metadataKey": "autoTaskSagaObjective",
      "required": false
    },
    {
      "input": "constraints",
      "promptParameter": "constraints",
      "metadataKey": "autoTaskSagaConstraints",
      "required": false
    },
    {
      "input": "workItems",
      "promptParameter": "workItems",
      "metadataKey": "autoTaskSagaWorkItems",
      "required": false
    },
    {
      "input": "verification",
      "promptParameter": "verification",
      "metadataKey": "autoTaskSagaVerification",
      "required": false
    },
    {
      "input": "references",
      "promptParameter": "references",
      "metadataKey": "autoTaskSagaReferences",
      "required": false
    },
    {
      "input": "runOptions",
      "promptParameter": "runOptions",
      "metadataKey": "autoTaskSagaRunOptions",
      "required": false
    },
    {
      "input": "targetScopeMarkdown",
      "promptParameter": "targetScopeMarkdown",
      "producer": "frontend-computed"
    }
  ]
}
