{
  "$schema": "https://tasks.hagicode.com/schemas/task-preset-plugin/task-preset.schema.json",
  "taskKey": "hagiCodeReleaseNotesAutoUpdate",
  "scriptKey": "autotask.hagicode-release-notes-auto-update",
  "defaultTargetType": "repository",
  "requirements": [
    { "type": "agent", "name": "any" },
    { "type": "cli", "name": "git", "command": "git", "args": ["--version"] }
  ],
  "targets": {
    "repositories": {
      "enabled": true,
      "selections": [
        {
          "id": "targetRepositories",
          "selectionMode": "multiple",
          "allowedAccessTypes": ["read", "write"],
          "required": true,
          "output": "targetRepositories",
          "scope": { "source": "owner-project-repositories" }
        }
      ]
    },
    "vaults": { "enabled": false },
    "projects": { "enabled": false }
  },
  "inputBindings": [
    {
      "input": "request",
      "promptParameter": "request",
      "metadataKey": "autoTaskReleaseNotesRequest",
      "required": true
    },
    {
      "input": "targetRepositories",
      "promptParameter": "targetRepositories",
      "metadataKey": "autoTaskReleaseNotesRepositories",
      "producer": "frontend-computed",
      "required": true
    },
    {
      "input": "targetScopeMarkdown",
      "promptParameter": "targetScopeMarkdown",
      "metadataKey": "autoTaskReleaseNotesScopeMarkdown",
      "producer": "frontend-computed",
      "required": true
    }
  ]
}
